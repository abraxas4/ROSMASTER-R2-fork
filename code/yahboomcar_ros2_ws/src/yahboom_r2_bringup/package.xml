<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yahboom_r2_bringup</name>
  <version>0.1.0</version>
  <description>ROSMASTER R2 on the common platform: ros2_control controllers, EKF sensor fusion, Cartographer, launch files</description>
  <maintainer email="moonjune.kim@gmail.com">abraxas4</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>yahboomcar_description</exec_depend>
  <exec_depend>yahboom_r2_hardware</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>ackermann_steering_controller</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- optional at runtime (only when the matching use_* arg is true):
       cartographer_ros, ydlidar_ros2_driver / sllidar_ros2, astra_camera,
       depthimage_to_laserscan, rtabmap_odom, joy, yahboomcar_ctrl -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
