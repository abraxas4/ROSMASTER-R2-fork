FROM ros:humble

# Install Nav2, SLAM, and dependencies
RUN apt-get update && apt-get install -y \
    ros-humble-nav2-bringup \
    ros-humble-nav2-smac-planner \
    ros-humble-nav2-regulated-pure-pursuit-controller \
    ros-humble-nav2-mppi-controller \
    ros-humble-slam-toolbox \
    ros-humble-robot-localization \
    ros-humble-cartographer-ros \
    ros-humble-nav2-collision-monitor \
    ros-humble-tf2-tools \
    ros-humble-xacro \
    python3-pip \
    git \
    && rm -rf /var/lib/apt/lists/*

# Build m-explore-ros2 from source
WORKDIR /opt/ros_ws/src
RUN git clone -b humble https://github.com/robo-friends/m-explore-ros2.git

WORKDIR /opt/ros_ws
RUN . /opt/ros/humble/setup.sh && \
    colcon build --packages-select explore_lite --symlink-install

# Set up workspace
WORKDIR /workspace
CMD ["/bin/bash"]
