<?xml version="1.0"?>
<!--
  ros2_control description for ROSMASTER R2 (Ackermann).
  Joint names are the ones in yahboomcar_R2.urdf.xacro.
    traction (rear, velocity) : back_right_joint, back_left_joint   (axis 0 1 0 -> + = forward)
    steering (front, position): front_right_steer_joint, front_left_steer_joint (axis 0 0 1 -> + = left turn)
    passive  (front wheels)   : front_right_wheel_joint (axis 0 1 0), front_left_wheel_joint (axis 0 -1 0 -> sign -1)
  Geometry (from URDF joint origins / wheel mesh):
    wheelbase      = 0.11922 - (-0.11607) = 0.23529 m
    traction track = 2 x 0.08425           = 0.1685 m
    steering track = 2 x 0.065             = 0.13 m  (steer pivot to pivot)
    wheel radius   = 0.0345 m (back_right_link.STL bounding box +-0.0345)
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="yahboomcar_r2_ros2_control" params="name use_mock_hardware:=false device:=/dev/myserial">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>yahboom_r2_hardware/R2SystemHardware</plugin>
          <param name="device">${device}</param>
          <param name="baud">115200</param>
          <param name="wheelbase">0.23529</param>
          <param name="traction_track">0.1685</param>
          <param name="steering_track">0.13</param>
          <param name="wheel_radius">0.0345</param>
          <!-- wheelbase the STM32 firmware uses to turn wz into a servo angle (not verified; tune) -->
          <param name="mcu_wheelbase">0.23529</param>
          <param name="max_linear">1.0</param>
          <param name="max_angular">3.0</param>
          <param name="max_steer">0.6</param>
          <!-- base_node_R2 calibration in yahboomcar_bringup_R2_launch.py: linear_scale_x 1.0, linear_scale_y 0.90 -->
          <param name="linear_scale">1.0</param>
          <param name="steer_report_scale">0.90</param>
          <!-- Ackman_driver_R2.py publishes -gz (board gz opposite ROS) and zeroes gz while |vx| < 0.03 -->
          <param name="imu_gyro_z_sign">-1.0</param>
          <param name="imu_zero_yaw_rate_when_stopped">true</param>
          <param name="command_period_ms">20</param>
          <param name="rx_timeout_ms">500</param>
          <param name="enable_auto_report">true</param>
          <!-- Ackman_driver_R2 calls set_car_type(5) every start (writes flash). Off by default here. -->
          <param name="set_car_type_on_activate">false</param>
          <!-- 0 = use MCU speed report (0x0A). >0 = per-wheel speed from encoder report (0x0D) -->
          <param name="encoder_ticks_per_rev">0</param>
        </xacro:unless>
      </hardware>

      <joint name="back_right_joint">
        <param name="role">traction_right</param>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="back_left_joint">
        <param name="role">traction_left</param>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="front_right_steer_joint">
        <param name="role">steer_right</param>
        <command_interface name="position">
          <param name="min">-0.6</param>
          <param name="max">0.6</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="front_left_steer_joint">
        <param name="role">steer_left</param>
        <command_interface name="position">
          <param name="min">-0.6</param>
          <param name="max">0.6</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="front_right_wheel_joint">
        <param name="role">passive_right</param>
        <param name="sign">1.0</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="front_left_wheel_joint">
        <param name="role">passive_left</param>
        <param name="sign">-1.0</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- On-board IMU (MPU9250 0x0B or ICM20948 0x0E report), frame imu_link -->
      <sensor name="imu_sensor">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w">
          <param name="initial_value">1.0</param>
        </state_interface>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z">
          <param name="initial_value">9.81</param>
        </state_interface>
        <param name="frame_id">imu_link</param>
      </sensor>
    </ros2_control>
  </xacro:macro>
</robot>
